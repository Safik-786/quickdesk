# Docker Hub Username (Used to pull/push images in docker-compose.prod.yml)
DOCKER_USERNAME=yourusername

# Database Credentials
DB_PASSWORD=your_super_secure_database_password
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/quickdesk

# JWT Authentication
JWT_SECRET=your_super_secure_jwt_secret
JWT_EXPIRES_IN=7d

# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
PORT=3000
FRONTEND_URL=http://localhost:80

# Email Notification System ('true' to enable, 'false' to disable)
ENABLE_EMAIL=true

# Free Google SMTP / Gmail Passkey Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-google-app-passkey
SMTP_FROM="QuickDesk Support <your-gmail-address@gmail.com>"
